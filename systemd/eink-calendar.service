[Unit]
Description=E-Ink Calendar display service
Documentation=https://github.com/mak3r/e-ink-calendar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as the dedicated non-sudo system user created in docs/runbook.md §4
# (`useradd --system --shell /usr/sbin/nologin eink-calendar`, added to spi,gpio).
# That user owns only its checkout (~/app) and ~/.config/eink-calendar/.
User=eink-calendar
Group=eink-calendar
# ~/app is a symlink to the currently-deployed release (docs/runbook.md §5,
# scripts/deploy.sh); systemd resolves it afresh on every start, so a deploy
# that repoints the symlink takes effect on the next `systemctl restart`.
WorkingDirectory=/home/eink-calendar/app
# eink_calendar/config.py reads EINK_CALENDAR_CONFIG (a file path), then falls
# back to ~/.config/eink-calendar/config.yaml. Set it explicitly so the unit
# does not depend on HOME resolution.
Environment=EINK_CALENDAR_CONFIG=/home/eink-calendar/.config/eink-calendar/config.yaml
# lgpio's `lg` C library drops its .lgd-nfy* notification FIFO in CWD; CWD here
# is the read-only release tree under ProtectSystem=strict, so lgpio init fails
# and gpiozero silently falls back to a pin factory that no longer exists on
# current kernels. Point it at PrivateTmp (issue #86, confirmed on hardware).
Environment=LG_WD=/tmp
# Fail loudly if the lgpio factory can't load, rather than falling back.
Environment=GPIOZERO_PIN_FACTORY=lgpio
# Guarantee the render-archive dir exists on the host before the sandbox binds
# it RW below — a hand-followed runbook §5 install never creates it, and
# ReadWritePaths does not create missing dirs (issue #86). `+` runs unsandboxed.
ExecStartPre=+/bin/mkdir -p /home/eink-calendar/app/data
ExecStartPre=+/bin/chown eink-calendar:eink-calendar /home/eink-calendar/app/data
ExecStart=/home/eink-calendar/app/.venv/bin/python -m eink_calendar.app
Restart=on-failure
RestartSec=5

# Hardening — the service needs GPIO/SPI, its checkout, and its config dir.
# UMask=0077 is the compensating control cited by
# eink_calendar/calendar_source/local_files.py: files the service writes
# outside write_private_text() (e.g. data/last_render.png) must not be
# world-readable — a render is a picture of the family's calendar.
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# The release-relative data dir (resolved through the ~/app symlink at each
# start) is guaranteed to exist by the ExecStartPre above, so no "-" tolerance
# is needed — a genuine failure to bind it should stop the unit with a clear
# error, not silently drop the mount and let the app crash on first write.
ReadWritePaths=/home/eink-calendar/app/data /home/eink-calendar/.config/eink-calendar
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# Device access (SPI/GPIO) is left at the default policy pending hardware
# bring-up (#15); tightening to DevicePolicy=closed + explicit DeviceAllow
# needs to be verified against the real Inky panel.

[Install]
WantedBy=multi-user.target
